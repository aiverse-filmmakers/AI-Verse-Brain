{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Initiative payload",
  "type": "object",
  "required": ["serves", "gap_refs", "hypothesis", "outcome", "score_components"],
  "properties": {
    "serves": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gap_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "hypothesis": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "score_components": {"type": "object"},
    "rank_result": {"type": "object"},
    "source_opportunity_ref": {"type": ["string", "null"]},
    "source_fingerprint": {"type": ["string", "null"]},
    "next_action": {"type": ["string", "null"]},
    "review_after": {"type": ["string", "null"]},
    "invalidation_conditions": {"type": "array", "items": {"type": "string"}},
    "evaluation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
