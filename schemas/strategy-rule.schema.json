{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategy rule payload",
  "type": "object",
  "required": ["evolution_tier", "applies_when", "instruction"],
  "properties": {
    "evolution_tier": {"enum": ["E0", "E1", "E2", "E3", "E4"]},
    "applies_when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "instruction": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "helpful_evidence_count": {"type": "integer", "minimum": 0},
    "harmful_evidence_count": {"type": "integer", "minimum": 0},
    "evaluation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "regression_passed": {"type": "boolean"},
    "source_learning_ref": {"type": ["string", "null"]},
    "previous_revision_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
