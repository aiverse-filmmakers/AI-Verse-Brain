{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Objective payload",
  "type": "object",
  "required": ["outcome", "criteria", "progress"],
  "properties": {
    "outcome": {"type": "string", "minLength": 1},
    "problem": {"type": ["string", "null"]},
    "desired_state": {"type": ["string", "null"]},
    "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "progress": {"enum": ["progressing", "waiting", "blocked", "stalled", "wrong_strategy", "invalidated", "complete_unverified", "verified_complete"]},
    "verification_level": {"enum": ["V0", "V1", "V2", "V3"]},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "boundaries": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "budget": {
      "type": "object",
      "properties": {"max_attempts": {"type": "integer", "minimum": 1}},
      "additionalProperties": true
    },
    "stall_threshold": {"type": "integer", "minimum": 1},
    "blocked_on": {"type": ["string", "null"]},
    "evaluation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "progress_ledger": {
      "type": "object",
      "properties": {
        "attempt_count": {"type": "integer", "minimum": 0},
        "non_progressing_attempts": {"type": "integer", "minimum": 0},
        "last_state_token": {"type": "string"},
        "last_observed_at": {"type": "string", "format": "date-time"},
        "last_progress_at": {"type": "string", "format": "date-time"},
        "last_evidence_refs": {"type": "array", "items": {"type": "string"}},
        "blocked_on": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": ["id", "statement", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["unverified", "passed", "failed", "insufficient_evidence", "not_applicable"]},
        "required_evidence": {"type": "string"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "evaluation_rationale": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
