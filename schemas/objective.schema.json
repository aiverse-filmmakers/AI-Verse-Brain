{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Objective payload",
  "type": "object",
  "required": ["outcome", "criteria", "progress"],
  "properties": {
    "outcome": {"type": "string", "minLength": 1},
    "problem": {"type": ["string", "null"]},
    "desired_state": {"type": ["string", "null"]},
    "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "progress": {"enum": ["progressing", "waiting", "blocked", "stalled", "wrong_strategy", "invalidated", "complete_unverified", "verified_complete"]},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "boundaries": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "budget": {"type": "object"}
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": ["id", "statement", "status"],
      "properties": {
        "id": {"type": "string"},
        "statement": {"type": "string"},
        "status": {"enum": ["unverified", "passed", "failed", "insufficient_evidence", "not_applicable"]},
        "required_evidence": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
