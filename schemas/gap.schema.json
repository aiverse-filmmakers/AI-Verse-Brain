{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gap payload",
  "type": "object",
  "required": ["desired_state_refs", "current_state_refs", "interpretation"],
  "properties": {
    "desired_state_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "current_state_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "interpretation": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
