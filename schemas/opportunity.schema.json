{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity payload",
  "type": "object",
  "required": ["gap_refs", "hypothesis", "confidence"],
  "properties": {
    "gap_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "hypothesis": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "mechanism": {"type": ["string", "null"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "cooldown_fingerprint": {"type": ["string", "null"]},
    "dedupe_key": {"type": ["string", "null"]},
    "score_components": {"type": "object"},
    "rank_result": {
      "type": "object",
      "required": ["eligible", "score", "gate_failures", "notification"],
      "properties": {
        "eligible": {"type": "boolean"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "gate_failures": {"type": "array", "items": {"type": "string"}},
        "notification": {"enum": ["INTERRUPT", "SURFACE", "BATCH", "STORE", "DROP"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
